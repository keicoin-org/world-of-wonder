{
    "name": "world-of-wonder",
    "version": "0.1.0",
    "repository": {
        "url": "git+https://github.com/keicoin-org/world-of-wonder.git"
    },
    "description": "A multiplayer 3d top down rpg whose currency and items live on a chain. Forked from orion3dgames/t5c.",
    "main": "./dist/client/index.html",
    "scripts": {
        "client-dev": "webpack serve --open --config webpack.dev.js",
        "client-start": "webpack serve --open --config webpack.dev.js",
        "client-build": "webpack --config webpack.prod.js",
        "server-debug": "node scripts/build-server.mjs --watch",
        "server-dev": "node scripts/build-server.mjs --watch",
        "server-start": "node dist/server/index.mjs",
        "server-build": "node scripts/build-server.mjs",
        "typecheck": "tsc --noEmit",
        "test:startup": "node scripts/build-server.mjs && node scripts/build-server.mjs --entry src/server/kei/node.test.ts --out dist/test/node.mjs && node dist/test/node.mjs",
        "test:economy": "node scripts/build-server.mjs --entry src/server/kei/Economy.test.ts --out dist/test/economy.mjs && node dist/test/economy.mjs",
        "test:market": "node scripts/build-server.mjs --entry src/server/kei/Market.test.ts --out dist/test/market.mjs && node dist/test/market.mjs",
        "test:inventory": "node scripts/build-server.mjs --entry src/server/kei/Inventory.test.ts --out dist/test/inventory.mjs && node dist/test/inventory.mjs",
        "test": "npm run test:startup && npm run test:economy && npm run test:market && npm run test:inventory",
        "test:e2e": "node scripts/build-server.mjs --entry src/server/kei/endtoend.test.ts --out dist/test/e2e.mjs && node dist/test/e2e.mjs"
    },
    "author": "Orion3d, Kei",
    "license": "MIT",
    "engines": {
        "node": ">=20.17.0"
    },
    "devDependencies": {
        "@babylonjs/gui-editor": "8.28.3",
        "@babylonjs/inspector": "8.28.3",
        "@babylonjs/materials": "8.28.3",
        "@colyseus/monitor": "^0.15.8",
        "@types/node": "^20.12.12",
        "@types/react": "^18.3.2",
        "@types/react-dom": "^18.3.0",
        "copy-webpack-plugin": "^14.0.0",
        "esbuild": "^0.28.1",
        "ts-loader": "^9.5.1",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.4.5",
        "webpack": "^5.92.0",
        "webpack-bundle-analyzer": "^4.10.2",
        "webpack-cli": "^5.1.4",
        "webpack-dev-server": "^5.0.4",
        "webpack-merge": "^5.10.0"
    },
    "dependencies": {
        "@babylonjs/core": "8.28.3",
        "@babylonjs/gui": "8.28.3",
        "@babylonjs/loaders": "8.28.3",
        "@babylonjs/serializers": "8.28.3",
        "@colyseus/core": "^0.15.57",
        "@colyseus/schema": "^2.0.37",
        "@colyseus/ws-transport": "^0.15.3",
        "axios": "^1.12.2",
        "babylonjs-gltf2interface": "8.28.3",
        "colyseus.js": "^0.15.28",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.22.2",
        "kei-transaction": "^0.3.0",
        "mysql2": "^3.10.2",
        "nanoid": "^3.3.8",
        "sqlite3": "^6.0.1",
        "winston": "^3.13.0"
    },
    "overrides": {
        "sockjs": {
            "uuid": "^11.1.1"
        }
    },
    "browserslist": {
        "production": [
            "> 5%"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    }
}
